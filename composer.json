{
  "name": "byjg/serializer",
  "description": "A powerful multi-format serialization library that converts objects, arrays, and data between JSON, XML, YAML, CSV, PHP serialize, and plain text formats with intelligent property mapping and transformation",
  "autoload": {
    "psr-4": {
      "ByJG\\Serializer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-json": "*",
    "ext-simplexml": "*",
    "symfony/yaml": "> 4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "suggest": {
    "ext-curl": "*"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT"
}
